<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Starship/Artemis Lunar Simulator</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #050505; color: #fff; font-family: monospace; }
        #canvas-container { width: 100vw; height: calc(100vh - 120px); }
        #dashboard { height: 120px; background-color: #111; border-top: 2px solid #333; padding: 15px; box-sizing: border-box; display: flex; flex-direction: column; }
        #slider { width: 100%; margin-bottom: 15px; cursor: pointer; }
        .telemetry { display: flex; justify-content: space-between; font-size: 16px; background: #222; padding: 10px; border-radius: 5px; }
    </style>
</head>
<body>
    <div id="canvas-container"></div>
    <div id="dashboard">
        <div style="font-weight: bold; margin-bottom: 5px;">Mission Timeline Scrubber (Day 0 to 21)</div>
        <input type="range" id="slider" min="0" max="21" step="0.01" value="0">
        <div class="telemetry">
            <div><strong>MET:</strong> Day <span id="met-readout">0.00</span></div>
            <div><strong>Phase:</strong> <span id="phase-readout">Launch & LEO Refuel</span></div>
            <div><strong>Starship Fuel:</strong> <span id="fuel-readout">100</span>%</div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

    <script>
        // 1. Setup Scene
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / (window.innerHeight - 120), 0.1, 1000);
        camera.position.set(20, 10, 30);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight - 120);
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.target.set(20, 0, 0);

        scene.add(new THREE.AmbientLight(0x404040, 1.5));
        const pointLight = new THREE.PointLight(0xffffff, 1.5);
        pointLight.position.set(20, 20, 20);
        scene.add(pointLight);

        // 2. Planets (Blueprint Style)
        const earthGeo = new THREE.SphereGeometry(5, 32, 32);
        const earthMat = new THREE.MeshStandardMaterial({ color: 0x002244, wireframe: true });
        const earth = new THREE.Mesh(earthGeo, earthMat);
        scene.add(earth);

        const moonGeo = new THREE.SphereGeometry(1.5, 24, 24);
        const moonMat = new THREE.MeshStandardMaterial({ color: 0x444444, wireframe: true });
        const moon = new THREE.Mesh(moonGeo, moonMat);
        moon.position.set(40, 0, 0);
        scene.add(moon);

        // 3. Vehicles
        const shipGroup = new THREE.Group();
        const shipMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.4, 1.5, 16), new THREE.MeshStandardMaterial({ color: 0xffffff }));
        shipMesh.rotation.x = Math.PI / 2; // Align nose along path
        shipGroup.add(shipMesh);

        const plume = new THREE.Mesh(new THREE.ConeGeometry(0.4, 1.5, 16), new THREE.MeshBasicMaterial({ color: 0xffaa00 }));
        plume.position.set(0, 0, -1.2); // Tail plume
        plume.rotation.x = -Math.PI / 2;
        plume.visible = false;
        shipGroup.add(plume);
        scene.add(shipGroup);

        const artemis = new THREE.Mesh(new THREE.ConeGeometry(0.3, 1.0, 16), new THREE.MeshStandardMaterial({ color: 0x00aaff }));
        artemis.rotation.x = Math.PI / 2;
        scene.add(artemis);

        // 4. UI Elements
        const slider = document.getElementById('slider');
        const metReadout = document.getElementById('met-readout');
        const phaseReadout = document.getElementById('phase-readout');
        const fuelReadout = document.getElementById('fuel-readout');

        // 5. Physics Logic
        function updateSimulation() {
            const day = parseFloat(slider.value);
            metReadout.innerText = day.toFixed(2);
            let phase = "", fuel = 100, burn = false;

            // Starship Path
            if (day < 2) {
                fuel = day < 0.5 ? 100 - (day/0.5)*95 : 5 + ((day-0.5)/1.5)*95;
                phase = day < 0.5 ? "Launch to Earth Orbit" : "LEO Refueling";
                burn = day < 0.5;
                const angle = day * Math.PI * 4;
                shipGroup.position.set(Math.cos(angle) * 6, Math.sin(angle) * 6, 0);
                shipGroup.lookAt(Math.cos(angle + 0.1) * 6, Math.sin(angle + 0.1) * 6, 0);
            } else if (day < 6) {
                fuel = 45; phase = "Trans-Lunar Coast";
                if (day > 2 && day < 2.1) burn = true;
                const p = (day - 2) / 4;
                shipGroup.position.set(6 + 34 * p, Math.sin(p * Math.PI) * 8, 0);
                shipGroup.lookAt(6 + 34 * (p+0.01), Math.sin((p+0.01) * Math.PI) * 8, 0);
            } else if (day < 8.5) {
                fuel = 20; phase = day < 8 ? "Lunar Orbit Insertion" : "Artemis Docked / Crew Transfer";
                if (day > 6 && day < 6.1) burn = true;
                const angle = (day - 6) * Math.PI * 4;
                shipGroup.position.set(40 + Math.cos(angle) * 2.5, Math.sin(angle) * 2.5, 0);
                shipGroup.lookAt(40 + Math.cos(angle + 0.1) * 2.5, Math.sin(angle + 0.1) * 2.5, 0);
            } else if (day < 9) {
                phase = "Attitude Flip & Tail-Down Descent"; burn = true;
                const p = Math.min((day - 8.5) / 0.5, 1);
                fuel = Math.max(3, 20 - p * 17);
                shipGroup.position.set(40, 2.5 - 4.0 * p, 0);
                // THE FLIP: Orient tail-down towards the South Pole (-Y axis)
                shipGroup.rotation.set(0, 0, 0);
                shipMesh.rotation.set(0, 0, 0); 
                plume.rotation.set(Math.PI, 0, 0);
                plume.position.set(0, -1.2, 0);
            } else {
                phase = "Landed: Surface Ops (Lunar South Pole)"; fuel = 3;
                shipGroup.position.set(40, -1.5, 0);
                shipGroup.rotation.set(0, 0, 0);
                shipMesh.rotation.set(0, 0, 0);
            }
            fuelReadout.innerText = fuel.toFixed(0);
            plume.visible = burn;

            // Artemis Path
            if (day < 5) {
                artemis.position.set(-100, -100, -100); 
            } else if (day < 8) {
                const p = (day - 5) / 3;
                artemis.position.set(6 + 34 * p, Math.sin(p * Math.PI) * -8, 0);
                artemis.lookAt(6 + 34 * (p+0.01), Math.sin((p+0.01) * Math.PI) * -8, 0);
            } else {
                const angle = (day - 8) * Math.PI * 4;
                artemis.position.set(40 + Math.cos(angle) * 2.5, Math.sin(angle) * 2.5, 0);
                artemis.lookAt(40 + Math.cos(angle + 0.1) * 2.5, Math.sin(angle + 0.1) * 2.5, 0);
            }
            renderer.render(scene, camera);
        }

        slider.addEventListener('input', updateSimulation);
        controls.addEventListener('change', () => renderer.render(scene, camera));
        updateSimulation(); // Initial render
    </script>
</body>
</html>